<!-- app/views/applicants/_experiences_fields.html.erb -->
<div class="row g-3">
  <div class="col-md-4">
    <label for="title" class="form-label">First name</label>
    <%= f.text_field :title, id: "title", placeholder: 'Job Title', class: 'form-control' %>
  </div>
  <div class="col-md-4">
    <label for="first_name" class="form-label">First name</label>
    <%= f.text_field :company, placeholder: 'Company', class: 'form-control' %>
  </div>
<div class="col-md-3">
    <label for="Location" class="form-label">First name</label>
    <%= f.text_field :location, id: "location", placeholder: 'Location', class: 'form-control' %>
  </div>
  <div class="col-md-1">
    <label>&nbsp;</br>&nbsp;</label>
    <%= link_to_remove_fields 'Remove', f%>
  </div>

  <div class="col-md-3">
  <label for="date_from" class="form-label">Start date</label>
    <%= f.date_field :start_date, id: 'date_from', class: 'form-control' %>
  </div>
  <div class="col-md-3">
  <label for="date_to" class="form-label">End date</label>
    <%= f.date_field :end_date, id: "date_to", class: 'form-control' %>
  </div>
  <div class="col-md-2">
    <label>&nbsp;</br>&nbsp;</label>
    <div class="form-check">
      <%= f.check_box :current, id: "current_job", placeholder: 'Current job', class: 'form-check-input' %>
      <label class="form-check-label" for="current_job">Current job</label>
    </div>
  </div>
  <div class="col-md-3">
    <label>Jod description</label>
    <%= f.text_area :description, placeholder: 'Job description', class: 'form-control' %>
  </div>
  <div class="col-md-1">
    <label>&nbsp;</br>&nbsp;</label>
  </div>
        
</div>
