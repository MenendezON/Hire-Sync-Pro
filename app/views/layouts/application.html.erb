<!DOCTYPE html>
<html>
  <head>
    <title>Hire Sync Pro</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag 'application', 'css/bootstrap.min', media: 'all', 'data-turbolinks-track': 'reload' %>
    <style>
      .bd-placeholder-img {
        font-size: 1.125rem;
        text-anchor: middle;
        -webkit-user-select: none;
        -moz-user-select: none;
        user-select: none;
      }

      @media (min-width: 768px) {
        .bd-placeholder-img-lg {
          font-size: 3.5rem;
        }
      }
    </style>
  
    <%= stylesheet_link_tag 'sidebars', media: 'all', 'data-turbolinks-track': 'reload' %>
  </head>

  <body>

    <main>
      <%= render "shared/sidebar" %>

      <div class="b-example-divider">
        <%= render "shared/top_bar" %>
        <div class="container-fluid">
          <% if notice %> 
            <p class="alert alert-success"><%= notice %></p> 
          <% end %>
          <% if alert %> 
            <p class="alert alert-danger"><%= alert %></p> 
          <% end %>
          <%= yield %>
        </div>
      </div>
    </main>
  
    <%= javascript_include_tag 'application', 'js/bootstrap.bundle', 'sidebars', 'custom', 'data-turbolinks-track': 'reload' %>
  </body>
</html>
