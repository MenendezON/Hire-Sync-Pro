<!DOCTYPE html>
<html>
  <head>
    <title>Hire Sync Pro</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="csrf-token" content="<%= form_authenticity_token %>" />

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag 'application', 'css/bootstrap.min', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= stylesheet_link_tag 'plugins/fontawesome-free/css/all.min.css' %>
    <% if !current_user %>
    <style>

      html,
      body {
        height: 100%;
      }

      body {
        display: flex;
        align-items: center;
        padding-top: 40px;
        padding-bottom: 40px;
        background-color: #f5f5f5;
      }

      .form-signin {
        width: 100%;
        max-width: 330px;
        padding: 15px;
        margin: auto;
        display:flex;
        flex-direction:column;
      }

      .form-signin .checkbox {
        font-weight: 400;
      }

      .form-signin .form-floating:focus-within {
        z-index: 2;
      }

      .form-signin input[type="email"] {
        margin-bottom: -1px;
        border-bottom-right-radius: 0;
        border-bottom-left-radius: 0;
      }

      .form-signin input[type="password"] {
        margin-bottom: 10px;
        border-top-left-radius: 0;
        border-top-right-radius: 0;
      }
    </style>
    <% end %>

    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
  </head>

  <body>
      <div class="container"> 
      
      <% if current_user %>
      <%= render 'base/navbar' %>
      <% end %>
        <% if notice %> 
          <p class="alert alert-success"><%= notice %></p> 
        <% end %>
        <% if alert %> 
          <p class="alert alert-danger"><%= alert %></p> 
        <% end %>
        <div class="row>
          <div class="col-12">
            <%= yield %>
          </div>
        </div>
      </div>
  </body>
</html>
