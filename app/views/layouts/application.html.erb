<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Hire Sync pro</title>

  <!-- Google Font: Source Sans Pro -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
  <!-- Font Awesome -->
  <%= stylesheet_link_tag "plugins/fontawesome-free/css/all.min.css" %>
  <!-- icheck bootstrap -->
  <%= stylesheet_link_tag "plugins/icheck-bootstrap/icheck-bootstrap.min.css" %>
  <!-- Theme style -->
  <%= stylesheet_link_tag "dist/css/adminlte.min.css" %>
</head>
<body class="hold-transition login-page">
<% if notice %> 
          <p class="alert alert-success"><%= notice %></p> 
        <% end %>
        <% if alert %> 
          <p class="alert alert-danger"><%= alert %></p> 
        <% end %>
<%= yield %>
<!-- jQuery -->
<%= javascript_include_tag 'plugins/jquery/jquery.min.js' %>
<!-- Bootstrap 4 -->
<%= javascript_include_tag 'plugins/bootstrap/js/bootstrap.bundle.min.js' %>
<!-- AdminLTE App -->
<%= javascript_include_tag 'dist/js/adminlte.min.js' %>
</body>
</html>

