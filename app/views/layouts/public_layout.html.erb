<!DOCTYPE html>
<html>
  <head>
    <title>Hire Sync Pro</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag 'application', 'css/bootstrap.min', media: 'all', 'data-turbolinks-track': 'reload' %>
  </head>

  <body>
    <div class="container-fluid">
      <% if notice %> 
        <p class="alert alert-success"><%= notice %></p> 
      <% end %>
      <% if alert %> 
        <p class="alert alert-danger"><%= alert %></p> 
      <% end %>
      <%= yield %>
    </div>
  
    <%= javascript_include_tag 'application', 'js/bootstrap.bundle', 'custom', 'data-turbolinks-track': 'reload' %>
  </body>
</html>
