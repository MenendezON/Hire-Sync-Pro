<div class='row'>
  <div class='col-12'>
    <h1>Categories <%= link_to "add new category", new_admin_category_path, class: 'btn btn-light' %></h1>
  </div>
</div>
<div class='row'>
  <div class='col-4'>
    <%= form_with model: @category, url: admin_categories_path do |form| %>
      <div class="col-12">
        <%= form.label :name, class: "form-label" %>
        <%= form.text_field :name, class: "form-control", placeholder:"Category's name" %>
      </div>
      <br/>
      <div class="col-12">
      <%= form.submit "Save", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
  <div class='col-8'>
    <div id="categories">
      <table class="table table-hover">
        <tr>
          <th>&sharp;</th>
          <th>Name</th>
          <th>Author</th>
          <th>Count</th>
          <th>Created</th>
        </tr>
        <% @categories.each do |category| %>
        <tr>
          <td><%= category.id %></td>
          <td><%= category.name %></td>
          <td><%= link_to category.user.full_name, admin_category_path(category) %></td>
          <td><%= category.posts.count %></td>
          <td><%= category.created_at %></td>
        </tr>
        <% end %>
      </table>
    </div>
  </div>
</div>

