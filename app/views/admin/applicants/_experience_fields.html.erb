<!-- app/views/applicants/_experiences_fields.html.erb -->
<div class="nested-fields">
  <div class="mb-3">
    <%= f.text_field :title, placeholder: 'Job Title', class: 'form-control' %>
  </div>
  <div class="mb-3">
    <%= f.text_field :company, placeholder: 'Company', class: 'form-control' %>
  </div>

  <div class="mb-3">
    <%= f.text_field :location, placeholder: 'Location', class: 'form-control' %>
  </div>
  
  <div class="mb-3">
    <%= f.radio_button :current, placeholder: 'Current job', class: 'form-control' %>
  </div>
    
  <div class="mb-3">
    <%= f.date_field :start_date, class: 'form-control' %>
  </div>
      
  <div class="mb-3">
    <%= f.date_field :end_date, class: 'form-control' %>
  </div>
        
  <div class="mb-3">
    <%= f.text_area :description, placeholder: 'Job description', class: 'form-control' %>
  </div>
          
  <%= link_to_remove_fields 'Remove', f %>
</div>
