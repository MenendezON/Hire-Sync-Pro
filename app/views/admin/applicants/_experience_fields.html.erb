<!-- app/views/applicants/_experiences_fields.html.erb -->
<div class="nested-fields">
  <%= f.text_field :title, placeholder: 'Job Title' %>
  <%= f.text_field :company, placeholder: 'Company' %>
  <%= f.text_field :location, placeholder: 'Location' %>
  <%= f.radio_button :current, placeholder: 'Current job' %>
  <%= f.date_field :start_date %>
  <%= f.date_field :end_date %>
  <%= f.text_area :description, placeholder: 'Job description' %>
  <%= link_to_remove_fields 'Remove', f %>
</div>
