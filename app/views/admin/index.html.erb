<h1>Admin#index</h1>
<p>Find me in app/views/admin/index.html.erb</p>

<%= form_with(model: @user, url: admin_index_path, method: :post) do |f| %>
    
    <div class="form-floating">
      <%= f.text_field :full_name, autofocus: true, autocomplete: "full_name", class: 'form-control'%>
      <%= f.label :full_name %>
    </div>
    
    <div class="form-floating">
      <%= f.email_field :email, autocomplete: "email", class: 'form-control' %>
      <%= f.label :email %>
    </div>

    <div class="form-floating">
    <%= f.select :role, User.roles.keys.map { |w| [w.humanize, w] }, include_blank: "Select a role" %>
    </div>
  
    <div class="form-floating">
      <%= f.password_field :password, autocomplete: "new-password", class: 'form-control' %>
      <%= f.label :password %>
      <% if @minimum_password_length %>
      <span id="passwordHelpInline" class="form-text">(<%= @minimum_password_length %> characters minimum)</span>
      <% end %>
    </div>
    
    <div class="form-floating">
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: 'form-control' %>
      <%= f.label :password_confirmation %>
    </div>
  
   
      <%= f.submit "Sign up", class: 'w-100 btn btn-lg btn-primary' %>
  
      
  <% end %>

<ul> The users
<% @users.each do |user| %>
    <%= form_for(user, url: admin_path(user), remote: true, method: :patch) do |f| %>
        <p><%= f.email_field :email %> - <%= f.select(:role, User.roles.keys.map { |w| [w.humanize, w] }) %> - <%= f.submit 'Update' %></p>
    <% end %>
<% end %>
</ul>
