<!-- Content Header (Page header) -->
<div class="content-header">
  <div class="container-fluid">
    <div class="row mb-2">
      <div class="col-sm-6">
        <h1 class="m-0">Jobs</h1>
      </div><!-- /.col -->
      <div class="col-sm-6">
        <ol class="breadcrumb float-sm-right">
          <li class="breadcrumb-item"><%= link_to "Home", root_path %></li>
          <li class="breadcrumb-item"><%= link_to "Admin", admin_index_path %></li>
          <li class="breadcrumb-item"><%= link_to "Jobs", admin_posts_path %></li>
          <li class="breadcrumb-item active">New job</li>
        </ol>
      </div><!-- /.col -->
    </div><!-- /.row -->
  </div><!-- /.container-fluid -->
</div>
<!-- /.content-header -->

<!-- Main content -->
<section class="content">
  <div class="container-fluid">
    <!-- Small boxes (Stat box) -->
    <div class="row">
      <%= form_with model: @post, url: admin_posts_path do |form| %>
      <div class="field">
        <%= form.label :title, class: "text-lg font-medium mb-2" %>
        <%= form.text_field :title, placeholder:"Job's title" %>
      </div>
      <div class="field">
        <%= form.label :country, class: "text-lg font-medium mb-2" %>
        <%= form.select :country, options_for_select(['Senegal', 'France', 'Haiti']), { prompt: 'Select a category' }, required: true, class: "form-control" %>
      </div>
      <div class="field">
        <%= form.label :city, class: "text-lg font-medium mb-2" %>
        <%= form.text_field :city, placeholder:"City" %>
      </div>
      <div class="field">
        <%= form.select :contract, options_for_select(['Stage', 'CDD', 'CDI', 'Consultant', 'Prestation', 'Autre']), {}, class: "form-control" %>
      </div>
      <div class="field">
        <%= form.number_field :length_contract, placeholder: "Experience (years)", class: "form-control" %>
      </div
      <div class="field">
        <%= form.label :deadline, class: "text-lg font-medium mb-2" %>
        <%= form.date_field :deadline, placeholder:"Job's deadline" %>
      </div>
      <div class="field">
        <%= form.label :summary, class: "text-lg font-medium" %>
        <%= form.text_area :summary, placeholder: "Job's summary" %>
      </div>
      <div class="field">
        <%= form.label :duties, class: "text-lg font-medium" %>
        <%= form.text_area :duties, placeholder: "Job's duties" %>
      </div>
      <div class="field">
        <%= form.label :qualifications, class: "text-lg font-medium" %>
        <%= form.text_area :qualifications, placeholder: "Job's qualifications" %>
      </div>
      <div class="field">
        <%= form.label :extrat, class: "text-lg font-medium" %>
        <%= form.text_area :extrat, placeholder: "Job's extrat" %>
      </div>
      <div class="field">
        <%= form.label :available, class: "text-lg font-medium" %>
        <%= form.check_box :available %>
      </div>
      <div class="field">
        <%= select("post", "category_id", current_user.company.users.map { |user| user.categories }.flatten.uniq.collect { |category| [category.name, category.id] }, { prompt: 'Select a category' }, required: true) %>
      </div>
      <%= form.submit "Save", class: "actions" %>
      <% end %>

      <div>
        <%= link_to "Back to posts", admin_posts_path %>
      </div>
    </div>
  <div>
</section>