<h1>Jobs <%= link_to "add new post", new_admin_post_path, class: 'btn btn-light' %></h1>

<div id="posts">
<table class="table table-hover">
<tr>
  <th>&sharp;</th>
  <th>Title</th>
  <th>Author</th>
  <th>Category</th>
  <th><svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="currentColor" class="bi bi-person-check" viewBox="0 0 16 16">
  <path d="M12.5 16a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7m1.679-4.493-1.335 2.226a.75.75 0 0 1-1.174.144l-.774-.773a.5.5 0 0 1 .708-.708l.547.548 1.17-1.951a.5.5 0 1 1 .858.514ZM11 5a3 3 0 1 1-6 0 3 3 0 0 1 6 0M8 7a2 2 0 1 0 0-4 2 2 0 0 0 0 4"/>
  <path d="M8.256 14a4.474 4.474 0 0 1-.229-1.004H3c.001-.246.154-.986.832-1.664C4.484 10.68 5.711 10 8 10c.26 0 .507.009.74.025.226-.341.496-.65.804-.918C9.077 9.038 8.564 9 8 9c-5 0-6 3-6 4s1 1 1 1z"/>
</svg></th>
  <th>Published</th>
  <th>Deadline</th>
  <th>Created</th>
</tr>
<% @posts.each_with_index do |post, index| %>
    <tr>
      <td><%= index+1 %></td>
      <td><%= link_to post.title, admin_post_path(post) %></td>
      <td><%= post.user.full_name %></td>
      <td><%= post.category.name %></td>
      <td><%= link_to post.applicants.count, admin_post_applicants_path(post) %></td>
      <td>
      <div class="toggle-container">
        <%= form_for post, url: admin_post_path(post), method: :patch, remote: true do |f| %>
          <div class="form-check form-switch">
            <%= f.check_box :available, id: 'toggle', class: 'form-check-input', onchange: "this.form.submit();" %>
            <%= f.label :available, class: 'form-check-label', for: 'toggle' do %>
              <div class="toggle-indicator"></div>
            <% end %>
          </div>
          <%= f.submit style: 'display:none;' %>
        <% end %>
      </div>
      
      </td>
      <td><%= post.deadline %></td>
      <td><%= post.created_at %></td>
    </tr>
  <% end %>
  </table>
</div>




