<!-- app/views/companies/edit.html.erb -->

<h1>Edit Company</h1>

<%= form_with(model: @company, url: admin_company_path(@company), method: :patch) do |form| %>
  <%= render 'form', form: form %>

  <div class="actions">
    <%= form.submit 'Update Company' %>
  </div>
<% end %>

<%= link_to 'Back', admin_companies_path %>
