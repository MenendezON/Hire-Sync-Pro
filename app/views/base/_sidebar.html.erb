<!-- Main Sidebar Container -->
<aside class="main-sidebar sidebar-dark-primary elevation-4">
    <!-- Brand Logo -->
    <a href="#" class="brand-link">
      <%= image_tag("dist/img/AdminLTELogo.png", alt: "Hire sync pro Logo", class: "brand-image img-circle elevation-3", style: "opacity: .8") %>
      <span class="brand-text font-weight-light">AdminLTE 3</span>
    </a>

    <!-- Sidebar -->
    <div class="sidebar">
      <!-- Sidebar user panel (optional) -->
      <div class="user-panel mt-3 pb-3 mb-3 d-flex">
        <div class="image">
          <%= image_tag("dist/img/user2-160x160.jpg", class: "img-circle elevation-2", alt: "User Image") %>
        </div>
        <div class="info">
          <%= link_to current_user.full_name, class: "d-block" %><br/>
          <%= form_tag(destroy_user_session_path, method: :delete) do %>
            <%= submit_tag "Sign out", class:'btn btn-link'%>
          <% end %>

        </div>
      </div>
      

      <!-- SidebarSearch Form -->
      <div class="form-inline">
        <div class="input-group" data-widget="sidebar-search">
          <input class="form-control form-control-sidebar" type="search" placeholder="Search" aria-label="Search">
          <div class="input-group-append">
            <button class="btn btn-sidebar">
              <i class="fas fa-search fa-fw"></i>
            </button>
          </div>
        </div>
      </div>

      <!-- Sidebar Menu -->
      <nav class="mt-2">
        <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
          <!-- Add icons to the links using the .nav-icon class with font-awesome or any other icon font library -->
          <li class="nav-item">
            <a href="#" class="nav-link">
              <i class="nav-icon fas fa-folder"></i>
              <p>
                Jobs
                <i class="fas fa-angle-left right"></i>
              </p>
            </a>
            <ul class="nav nav-treeview">
              <li class="nav-item">
                <%= link_to admin_posts_path, class: "nav-link" do %>
                  <i class="far fa-circle nav-icon"></i>
                  <p>All jobs</p>
                <% end %>
              </li>
              <li class="nav-item">
                <%= link_to admin_applicants_path, class: "nav-link" do %>
                  <i class="far fa-circle nav-icon"></i>
                  <p>All applicants</p>
                <% end %>
              </li>
              <li class="nav-item">
                <%= link_to new_admin_post_path, class: "nav-link" do %>
                  <i class="far fa-circle nav-icon"></i>
                  <p>Add a new job</p>
                <% end %>
              </li>
              <li class="nav-item">
                <%= link_to admin_categories_path, class: "nav-link" do %>
                  <i class="far fa-circle nav-icon"></i>
                  <p>Categories</p>
                <% end %>
              </li>
            </ul>
          </li>
          <li class="nav-item">
            <a href="#" class="nav-link">
              <i class="nav-icon fas fa-users"></i>
              <p>
                Users
                <i class="fas fa-angle-left right"></i>
              </p>
            </a>
            <ul class="nav nav-treeview">
              <li class="nav-item">
                <%= link_to admin_users_path, class: "nav-link" do %>
                  <i class="far fa-circle nav-icon"></i>
                  <p>All users</p>
                <% end %>
              </li>
            </ul>
          </li>
          <!-- begin Company links -->
          <li class="nav-item">
            <a href="#" class="nav-link">
              <i class="nav-icon fas fa-building"></i>
              <p>
                Societies
                <i class="fas fa-angle-left right"></i>
              </p>
            </a>
            <ul class="nav nav-treeview">
              <li class="nav-item">
                <%= link_to admin_companies_path, class: "nav-link" do %>
                  <i class="far fa-circle nav-icon"></i>
                  <p>All companies</p>
                <% end %>
                <%= link_to new_admin_company_path, class: "nav-link" do %>
                  <i class="far fa-circle nav-icon"></i>
                  <p>Add a new company</p>
                <% end %>
              </li>
            </ul>
          </li>
        </ul>
      </nav>
      <!-- /.sidebar-menu -->
    </div>
    <!-- /.sidebar -->
  </aside>