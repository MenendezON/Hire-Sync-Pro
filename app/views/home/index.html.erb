<h1>Posts</h1>

<div id="posts">
<table class="table table-hover">
<tr>
  <th>Slug</th>
  <th>Title</th>
  <th>Category</th>
  <th>Deadline</th>
  <th>Created</th>
  <th>Action</th>
</tr>
  <% @posts.each do |post| %>
    <tr>
      <td><%= post.slug %></td>
      <td><%= post.title %></td>
      <td><%= post.category.name %></td>
      <td><%= post.deadline %></td>
      <td><%= post.created_at %></td>
      <% if current_user && !current_user.user? %>
        <td><%= link_to "Show this job", admin_post_path(post) %></td>
      <% else %>
        <td><%= link_to "Show this job", post_path(post) %></td>
      <% end %>
    </tr>
  <% end %>
  </table>
</div>
<div>
<% if user_signed_in? %>
    <%= current_user.email %>
    <%= link_to "Admin dashboard", admin_index_path if current_user.admin? || current_user.moderator? %>
    <%= link_to "Sign out", destroy_user_session_path, data:{turbo: "false"}, method: :delete %></li>
<% else %>
    <%= link_to "Sign in", new_user_session_path %>
    <%= link_to "Sign up", new_user_registration_path %>
<% end %>
</div>



