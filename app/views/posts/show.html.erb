<% if @post %>
  <h2><%= @post.title %></h2>
  <p><strong>Duty station:</strong> <%= @post.location %></p>
  <p><strong>Deadline:</strong> <%= @post.deadline %></p>
  <h3>Summary</h3>
  <p><%= @post.summary %></p>
  <h3>Duties</h3>
  <p><%= @post.duties %></p>
  <h3>Qualifications</h3>
  <p><%= @post.qualifications %></p>
  <h3>Further informations</h3>
  <p><%= @post.extrat %></p>
  
  


  <div>
  <%= link_to "Edit this post", edit_post_path(@post) %> |
  <%= link_to "Back to posts", posts_path %>

  <%= button_to "Destroy this post", @post, method: :delete %>
</div>
<% else %>
  <p>Post not found</p>
<% end %>

