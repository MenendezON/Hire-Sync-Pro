<h1>Posts <%= link_to "+", new_post_path %></h1>

<div id="posts">
<table cellspacing="0" cellpadding="5" border="1">
<tr>
  <th>Slug</th>
  <th>Title</th>
  <th>Category</th>
  <th>Deadline</th>
  <th>Created</th>
  <th>Action</th>
</tr>
  <% @posts.each do |post| %>
    <tr>
      <td><%= post.slug %></td>
      <td><%= post.title %></td>
      <td><%= post.category.name %></td>
      <td><%= post.deadline %></td>
      <td><%= post.created_at %></td>
      <td><%= link_to "Show this post", post %></td>
    </tr>
  <% end %>
  </table>
</div>




